# .gitignore for pov-ansible project

# Vagrant
.vagrant/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
terraform.tfstate*
.terraform.lock.hcl

# Ansible
*.retry

# SSH, keys, certs
*.pem
*.key
certs/*.pem
certs/*.key

# Environment
.env
.env.*

# Python
__pycache__/
*.py[cod]
*.pyo

# Logs and crash reports
*.log
crash.log

# IDEs / editors
.vscode/
.idea/

# macOS
.DS_Store

# Misc
node_modules/
*.swp
/.venv/

# Vagrant
.vagrant/

# SSH private keys
.ssh/id_*
.ssh/*.pem

# Ansible
*.retry

# OS/editor files
.DS_Store
Thumbs.db
*.swp

# Secrets
.env
*.secret
*.key

# Local notes and logs
logs.md
note.md